# Django
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_SETTINGS_MODULE=core.settings.local
DJANGO_ALLOWED_HOSTS=

# Senha dos usuários de seed local (manage.py seed_decks) — defina o valor
# que preferir; documentado como referência em frontend/README.md.
SEED_PASSWORD=change-me-seed-password

# PostgreSQL (banco relacional do Django: auth/Permission/Group/sessões/admin)
POSTGRES_DB=anki_generator
POSTGRES_USER=anki_generator
POSTGRES_PASSWORD=anki_generator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB (persistência de decks/cards/estatísticas — ver apps/decks)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=anki_generator
MONGODB_AUTH_SOURCE=admin
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_SSL=false

# Celery + RabbitMQ (broker) + Redis (result backend/cache)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1

# Google OAuth (login social — ver apps/accounts)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback/

# E-mail (recuperação de senha — ver apps/accounts/serializers.py). Em dev
# local (core.settings.local) o backend é console (imprime no terminal),
# não precisa de RESEND_API_KEY. Só produção (core.settings.production) usa
# o relay SMTP do Resend de verdade.
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=onboarding@resend.dev
RESEND_API_KEY=

# Exportação Anki (Sprint 11) — bucket S3 privado dos .apkg. As credenciais
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) vêm do usuário IAM dedicado, com
# policy restrita a este bucket; nunca commitar valores reais.
AWS_S3_EXPORT_BUCKET=
AWS_S3_REGION_NAME=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Só em dev local com o S3 falso do compose (`docker compose --profile s3-local up -d`); deixe
# vazio em produção (AWS real). ENDPOINT = como os containers alcançam o S3 local
# (upload); PUBLIC_ENDPOINT = como o NAVEGADOR o alcança (assina a URL de download).
# Exemplo dev: AWS_S3_ENDPOINT_URL=http://s3-local:5000
#              AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
#              AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test
#              AWS_S3_EXPORT_BUCKET=anki-exports-dev
AWS_S3_ENDPOINT_URL=
AWS_S3_PUBLIC_ENDPOINT_URL=
# Limites/TTLs opcionais (padrões em core/settings/base.py):
# EXPORT_MAX_CARDS=100
# DOCUMENT_GENERATOR_EXPORT_READ_TIMEOUT=300
