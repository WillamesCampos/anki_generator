APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

MAX_CARDS_PER_GENERATION=10
AUDIO_OUTPUT_DIR=/data/anki_audio

# JWT de serviço (Sprint 5, autenticacao-service-to-service-jwt) — verifica
# chamadas vindas do Django. Precisa ser o MESMO JSON `{"kid": "secret"}`
# configurado em SERVICE_JWT_KEYS do lado Django (django/.env) — a chave
# usada pelo Django (SERVICE_JWT_ACTIVE_KID) precisa existir aqui também.
# Gere um segredo real por ambiente, nunca reaproveite o exemplo abaixo.
SERVICE_JWT_KEYS={"v1":"troque-por-um-segredo-gerado-com-secrets.token_urlsafe"}
