# SPA (Vite) — copie para .env.local e ajuste. Convenção do ecossistema Vite
# (.env.example), diferente de config.example.env do django/microservices —
# variáveis Vite exigem o prefixo VITE_ pra serem expostas ao client-side.

# Base da API do Django (ver django/core/urls.py)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Client ID do OAuth do Google (Google Cloud Console) — usado pelo botão de
# login da SPA. Mesmo projeto OAuth cujo Client ID/Secret já são esperados
# em django/.env (GOOGLE_OAUTH_CLIENT_ID/SECRET) — aqui só o Client ID
# (público, seguro de expor no bundle do frontend), nunca o secret.
VITE_GOOGLE_CLIENT_ID=
